# ============================================================================
# WattBot RAG Streamlit base environment — CPU only (no app code)
#
# App code is pulled at container start via curl|tar in RunAI job args.
#
# Build:
#   docker build -f rag_app/deploy/Dockerfile.streamlit -t rag-streamlit-env .
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit openai httpx numpy python-dotenv

ENV RAG_MODE=remote
ENV VLLM_BASE_URL=http://localhost:8000/v1
ENV EMBEDDING_SERVICE_URL=http://localhost:8080

EXPOSE 8501
