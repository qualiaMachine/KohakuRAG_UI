# ============================================================================
# Embedding Server base environment — CUDA + Python + deps (no app code)
#
# App code is pulled at container start via curl|tar in RunAI job args.
#
# Build:
#   docker build -f rag_app/deploy/Dockerfile.embedding -t rag-embedding-env .
# ============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3-pip curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

WORKDIR /app

RUN pip install --no-cache-dir \
    torch torchvision --index-url https://download.pytorch.org/whl/cu124 \
    && pip install --no-cache-dir \
    fastapi uvicorn httpx \
    'transformers>=4.42,<5' accelerate huggingface_hub safetensors \
    sentence-transformers

ENV EMBEDDING_MODEL=jinaai/jina-embeddings-v4
ENV EMBEDDING_DIM=1024

EXPOSE 8080
