# === OCR Server (GPU) ===
OCR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OCR_PORT=8090
OCR_HOST=0.0.0.0
OCR_DEVICE=auto
# Max image resolution (pixels) — higher = better quality but more VRAM
OCR_MAX_PIXELS=1003520

# === Streamlit UI ===
OCR_SERVICE_URL=http://localhost:8090

# === vLLM backend (alternative to local transformers) ===
# Set VLLM_BASE_URL to use a remote vLLM server instead of loading locally
# VLLM_BASE_URL=http://ocr-vllm:8090/v1

# === HuggingFace cache (RunAI shared PVC) ===
# HF_HOME=/models/.cache/huggingface
# HF_HUB_CACHE=/models/.cache/huggingface
