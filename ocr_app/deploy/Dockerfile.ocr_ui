# ============================================================================
# OCR Streamlit UI base environment — Python + Streamlit deps (no app code)
#
# This image provides the runtime environment only. App code is pulled
# at container start via curl|tar in the RunAI job arguments.
#
# Build:
#   docker build -f ocr_app/deploy/Dockerfile.ocr_ui -t vlm-ocr-ui-env .
#
# Use in RunAI:
#   Image: vlm-ocr-ui-env
#   Command: bash
#   Arguments: -c "curl -sL <repo-tarball> | tar xz -C /tmp && cd /tmp/... && streamlit run ocr_app/app.py ..."
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install UI Python deps (no torch/GPU libs)
RUN pip install --no-cache-dir \
    streamlit httpx Pillow python-dotenv

ENV OCR_SERVICE_URL=http://localhost:8090

EXPOSE 8501
