# ============================================================================
# OCR Server — Qwen2.5-VL served via FastAPI (GPU required)
#
# Build:
#   docker build -f ocr_app/deploy/Dockerfile.ocr_server -t vlm-ocr-server .
#
# Run:
#   docker run --gpus all -p 8090:8090 vlm-ocr-server
#
# With shared model cache (RunAI PVC or local):
#   docker run --gpus all -p 8090:8090 \
#     -v /path/to/hf_cache:/models/.cache/huggingface \
#     -e HF_HOME=/models/.cache/huggingface \
#     vlm-ocr-server
# ============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

WORKDIR /app

# Install PyTorch for CUDA 12.4
RUN pip install --no-cache-dir \
    torch torchvision --index-url https://download.pytorch.org/whl/cu124

# Install OCR server dependencies
COPY ocr_app/requirements_server.txt .
RUN pip install --no-cache-dir -r requirements_server.txt

# Copy server code
COPY ocr_app/scripts/ocr_server.py /app/scripts/ocr_server.py

# Default env vars
ENV OCR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
ENV OCR_PORT=8090
ENV OCR_HOST=0.0.0.0
ENV OCR_DEVICE=auto
ENV OCR_MAX_PIXELS=1003520

EXPOSE 8090

CMD ["python", "scripts/ocr_server.py"]
