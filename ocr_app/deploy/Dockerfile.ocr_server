# ============================================================================
# Extraction Server base environment — CPU only (no GPU needed)
#
# The extraction server just does PDF text extraction (PyMuPDF) and
# HTTP calls to vLLM/Ollama. All GPU work happens in the LLM/VLM server.
#
# Build:
#   docker build -f ocr_app/deploy/Dockerfile.ocr_server -t ocr-extract-env .
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi uvicorn python-multipart httpx pymupdf Pillow

ENV OCR_PORT=8090
ENV OCR_HOST=0.0.0.0
ENV LLM_BASE_URL=http://localhost:8000/v1
ENV VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

EXPOSE 8090
